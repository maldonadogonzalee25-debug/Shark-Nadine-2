<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no" />
<title>Depredation Log — Shark Depredation Event Reporter</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@500;600;700;800&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css" />

<style>
  :root{
    --navy:#0B2733; --navy2:#12333f;
    --teal:#1E6B7A; --teal-l:#2f8ea0;
    --coral:#E4572E; --coral-d:#c1431f;
    --paper:#FBF7EC; --buff:#F1E8D3; --sand:#E6DBBE; --line:#D7C7A2;
    --ink:#12242c; --muted:#5d6c71;
    --ok:#2f7d5b;
    --shadow:0 6px 24px rgba(9,25,32,.16);
    --shadow-lg:0 18px 48px rgba(9,25,32,.28);
  }
  *{box-sizing:border-box}
  html,body{height:100%;margin:0}
  body{
    font-family:"Inter",system-ui,sans-serif;
    color:var(--ink); background:var(--navy);
    overflow:hidden;
    -webkit-text-size-adjust:100%;
  }
  .lbl{font-family:"Archivo",sans-serif;text-transform:uppercase;letter-spacing:.08em}
  .mono{font-family:"JetBrains Mono",monospace}

  /* ---------- App shell ---------- */
  #app{display:flex;flex-direction:column;height:100%}
  header{
    display:flex;align-items:center;gap:14px;
    padding:10px 16px;background:var(--navy);color:var(--paper);
    border-bottom:1px solid #0a3040;z-index:600;
  }
  .brand{display:flex;align-items:center;gap:11px;min-width:0}
  .brand svg{flex:none}
  .brand h1{
    font-family:"Archivo",sans-serif;font-weight:800;font-size:16px;
    letter-spacing:.02em;margin:0;line-height:1.05;white-space:nowrap}
  .brand .sub{font-size:10.5px;color:#8fb4bf;letter-spacing:.14em;text-transform:uppercase;margin-top:2px}
  header .spacer{flex:1}
  .count-pill{
    font-family:"JetBrains Mono",monospace;font-size:12px;
    background:#0a2a37;border:1px solid #1c4a5a;color:#bfe0e8;
    padding:6px 11px;border-radius:999px;white-space:nowrap}
  .count-pill b{color:#fff}
  .hdr-btn{
    font-family:"Archivo",sans-serif;text-transform:uppercase;letter-spacing:.06em;
    font-size:12px;font-weight:600;cursor:pointer;
    background:#0a2a37;color:#d7ebf0;border:1px solid #1c4a5a;
    padding:8px 12px;border-radius:8px;display:inline-flex;align-items:center;gap:7px}
  .hdr-btn:hover{background:#103a49;border-color:#2a6577}
  .hdr-btn svg{width:14px;height:14px}

  /* export dropdown */
  .menu{position:relative}
  .menu-panel{
    position:absolute;right:0;top:calc(100% + 8px);min-width:230px;
    background:var(--paper);border:1px solid var(--line);border-radius:12px;
    box-shadow:var(--shadow-lg);padding:6px;display:none;z-index:800}
  .menu-panel.open{display:block}
  .menu-panel button{
    width:100%;text-align:left;background:none;border:0;cursor:pointer;
    padding:10px 11px;border-radius:8px;color:var(--ink);
    font-family:"Inter";font-size:13px;display:flex;flex-direction:column;gap:2px}
  .menu-panel button:hover{background:var(--buff)}
  .menu-panel button b{font-family:"Archivo";text-transform:uppercase;letter-spacing:.05em;font-size:11.5px}
  .menu-panel button span{color:var(--muted);font-size:11px}
  .menu-panel hr{border:0;border-top:1px solid var(--line);margin:5px 4px}

  /* ---------- Body: map + sidebar ---------- */
  .body{flex:1;display:flex;min-height:0;position:relative}
  #map{flex:1;background:#a9c6cf;z-index:1}

  aside{
    width:336px;flex:none;background:var(--paper);
    border-left:1px solid var(--line);display:flex;flex-direction:column;min-height:0}
  .aside-head{
    padding:13px 16px 11px;border-bottom:1px solid var(--line);
    display:flex;align-items:baseline;justify-content:space-between}
  .aside-head h2{font-family:"Archivo";font-weight:700;font-size:13px;letter-spacing:.1em;text-transform:uppercase;margin:0;color:var(--navy)}
  .aside-head .n{font-family:"JetBrains Mono";font-size:12px;color:var(--muted)}
  .log{flex:1;overflow-y:auto;padding:10px 12px 24px}

  .empty{padding:28px 18px;text-align:center;color:var(--muted)}
  .empty svg{opacity:.5;margin-bottom:10px}
  .empty p{font-size:13px;line-height:1.5;margin:0}
  .empty b{color:var(--ink)}

  .entry{
    background:#fff;border:1px solid var(--line);border-radius:12px;
    padding:11px 12px;margin-bottom:10px;cursor:pointer;position:relative;
    transition:border-color .12s, box-shadow .12s}
  .entry:hover{border-color:var(--coral);box-shadow:0 3px 12px rgba(228,87,46,.14)}
  .entry .row1{display:flex;align-items:center;gap:8px;margin-bottom:6px}
  .entry .dot{width:11px;height:11px;border-radius:50%;background:var(--coral);flex:none;box-shadow:0 0 0 3px rgba(228,87,46,.18)}
  .entry .poly-dot{border-radius:3px;background:var(--teal);box-shadow:0 0 0 3px rgba(30,107,122,.18)}
  .entry .hex-dot{border-radius:2px;transform:rotate(0deg);background:var(--coral);box-shadow:0 0 0 3px rgba(228,87,46,.18)}
  .tag.hex{background:#fbe3da;color:var(--coral-d)}
  .entry .date{font-family:"JetBrains Mono";font-size:11.5px;color:var(--muted);font-weight:500}
  .entry .sp{font-family:"Archivo";font-weight:700;font-size:14px;color:var(--ink);line-height:1.25;margin-bottom:3px}
  .entry .sp .arrow{color:var(--coral);font-weight:800;padding:0 4px}
  .entry .coord{font-family:"JetBrains Mono";font-size:10.5px;color:var(--teal);letter-spacing:.01em}
  .entry .meta{display:flex;gap:8px;margin-top:7px;flex-wrap:wrap}
  .tag{font-family:"Archivo";text-transform:uppercase;letter-spacing:.05em;font-size:9.5px;font-weight:600;
    padding:3px 7px;border-radius:5px;background:var(--buff);color:var(--navy)}
  .tag.photo{background:#0a2a37;color:#bfe0e8}
  .tag.lost{background:#fbe3da;color:var(--coral-d)}

  /* ---------- Map overlays ---------- */
  .map-tools{
    position:absolute;top:12px;left:12px;z-index:500;
    display:flex;flex-direction:column;gap:8px}
  .tool-group{
    background:var(--paper);border:1px solid var(--line);border-radius:12px;
    box-shadow:var(--shadow);padding:8px;display:flex;flex-direction:column;gap:6px;width:184px}
  .tool-group .gl{font-family:"Archivo";text-transform:uppercase;letter-spacing:.1em;font-size:9.5px;color:var(--muted);padding:1px 3px 3px}
  .tool{
    font-family:"Archivo";font-weight:600;font-size:12.5px;letter-spacing:.03em;
    cursor:pointer;border:1px solid var(--line);background:#fff;color:var(--ink);
    padding:9px 10px;border-radius:9px;display:flex;align-items:center;gap:9px;text-align:left;width:100%}
  .tool:hover{border-color:var(--coral);background:#fff}
  .tool.active{background:var(--coral);border-color:var(--coral);color:#fff}
  .tool .ic{width:20px;height:20px;flex:none;display:grid;place-items:center}
  .tool svg{width:18px;height:18px}
  .grid-status{display:flex;align-items:center;justify-content:space-between;gap:8px;padding:2px 3px 0}
  .grid-show{display:flex;align-items:center;gap:6px;font-family:"Archivo";font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.04em;color:var(--navy);cursor:pointer}
  .grid-show input{accent-color:var(--teal);width:14px;height:14px}
  .hexn{font-size:10.5px;color:var(--teal)}
  .grid-hint{font-size:10px;color:var(--muted);line-height:1.35;padding:2px 3px 0}
  .draw-ctrls{display:none;align-items:center;gap:6px;flex-wrap:wrap;margin-top:8px;padding-top:8px;border-top:1px solid rgba(0,0,0,.08)}
  .draw-ctrls.on{display:flex}
  .draw-count{font-family:"JetBrains Mono",monospace;font-size:10px;color:var(--teal);margin-right:auto}
  .draw-ctrls button{font-family:"Archivo";font-size:10.5px;font-weight:600;letter-spacing:.02em;color:var(--navy);background:#fff;border:1px solid rgba(0,0,0,.14);border-radius:7px;padding:5px 9px;cursor:pointer}
  .draw-ctrls button:active{transform:translateY(1px)}
  .draw-ctrls button:disabled{opacity:.4;cursor:default}
  .draw-ctrls .draw-finish{background:var(--coral);border-color:var(--coral);color:#fff}
  .draw-vertex{width:12px;height:12px;border-radius:50%;background:#fff;border:2.5px solid var(--coral);box-shadow:0 1px 4px rgba(0,0,0,.3)}
  .draw-vertex.first{background:var(--coral)}
  .grid-toggle{display:flex;align-items:center;gap:7px;margin-top:9px;font-family:"Archivo";font-size:11.5px;font-weight:600;color:var(--navy);cursor:pointer}
  .grid-toggle input{accent-color:var(--teal);width:14px;height:14px;cursor:pointer}
  .grid-status{align-items:center;gap:6px;margin-top:6px;font-family:"JetBrains Mono",monospace;font-size:10px;color:var(--teal)}
  .tool-sub{font-size:11px;font-weight:600;padding:7px 10px;background:var(--paper);color:var(--muted)}
  .tool-sub:hover{color:var(--navy);border-color:var(--teal)}
  .tool-sub .ic{width:16px;height:16px}
  .tool-sub svg{width:14px;height:14px}
  .tool.loading{opacity:.7;pointer-events:none}
  .help-btn{width:38px;padding:0;justify-content:center}
  .sync-pill{display:inline-flex;align-items:center;gap:7px;cursor:pointer;border-radius:999px;
    font-family:"Archivo";text-transform:uppercase;letter-spacing:.05em;font-size:11px;font-weight:600;
    padding:7px 12px;border:1px solid #1c4a5a;background:#0a2a37;color:#8fb4bf}
  .sync-pill svg{width:14px;height:14px}
  .sync-pill.ok{background:#123b31;border-color:#1f6b53;color:#a9e6cf}
  .sync-pill.pending{background:#3a2a12;border-color:#7a5a1f;color:#e6c98a}
  .sync-pill.pending svg{animation:pulse 1.1s infinite}
  .sync-pill.off{border-style:dashed}
  .tag.synced{background:#123b31;color:#a9e6cf}
  .tag.unsynced{background:#3a2a12;color:#e6c98a}
  .code-box{position:relative;margin:2px 0 4px}
  .code-box textarea{width:100%;height:150px;font-family:"JetBrains Mono";font-size:11px;line-height:1.5;
    border:1px solid var(--line);border-radius:10px;padding:11px 12px;background:#0d2a34;color:#cfe8ee;resize:vertical;white-space:pre}
  .code-copy{position:absolute;top:8px;right:8px;font-family:"Archivo";text-transform:uppercase;letter-spacing:.05em;
    font-size:10.5px;font-weight:700;background:var(--teal);color:#fff;border:0;border-radius:7px;padding:6px 10px;cursor:pointer}
  .code-copy:hover{background:var(--teal-l)}
  .setup-steps{counter-reset:s;list-style:none;padding:0;margin:0 0 14px}
  .setup-steps li{position:relative;padding:0 0 10px 30px;font-size:13px;line-height:1.5;color:var(--ink)}
  .setup-steps li::before{counter-increment:s;content:counter(s);position:absolute;left:0;top:0;
    width:21px;height:21px;border-radius:50%;background:var(--navy);color:#fff;font-family:"Archivo";font-weight:700;font-size:11px;display:grid;place-items:center}
  .setup-steps code{font-family:"JetBrains Mono";font-size:12px;background:var(--buff);padding:1px 5px;border-radius:4px}
  .sync-status-line{font-size:12px;color:var(--muted);margin-top:4px}
  .help-btn svg{width:16px;height:16px}
  .wlead{font-size:14.5px;line-height:1.55;color:var(--ink);margin:0 0 18px}
  .wsteps{display:flex;flex-direction:column;gap:13px;margin:0 0 6px}
  .wstep{display:flex;gap:12px;align-items:flex-start}
  .wstep .wn{flex:none;width:27px;height:27px;border-radius:50%;background:var(--coral);color:#fff;font-family:"Archivo";font-weight:800;font-size:13px;display:grid;place-items:center;margin-top:1px}
  .wstep .wt{font-size:14px;line-height:1.45;color:var(--ink)}
  .wstep .wt b{font-family:"Archivo";font-weight:700}
  .wcode{font-family:"JetBrains Mono";font-size:12.5px;background:var(--buff);padding:1px 6px;border-radius:5px;border:1px solid var(--line)}
  .wfoot{font-size:12px;color:var(--muted);line-height:1.55;margin-top:16px;padding-top:13px;border-top:1px solid var(--line)}
  .wfoot b{color:var(--coral-d);font-family:"Archivo";text-transform:uppercase;letter-spacing:.05em;font-size:10.5px}
  .participant-btn.set{background:#123b31;border-color:#1f6b53;color:#a9e6cf}
  .participant-btn.set:hover{background:#164a3d}
  .participant-btn.set #participantLabel{font-family:"JetBrains Mono";letter-spacing:.04em}
  .participant-btn:not(.set){border-style:dashed}
  .pcode-row{display:flex;gap:8px}
  .pcode-row input{flex:1}
  .pcode-gen{font-family:"Archivo";text-transform:uppercase;letter-spacing:.05em;font-size:11px;font-weight:700;
    background:var(--teal);color:#fff;border:0;border-radius:9px;padding:0 14px;cursor:pointer;white-space:nowrap}
  .pcode-gen:hover{background:var(--teal-l)}
  .pcode-note{background:#eef6f8;border:1px solid #cfe4e9;border-radius:10px;padding:11px 13px;font-size:12.5px;color:#3a5a63;line-height:1.5;margin-bottom:16px}
  .pcode-note b{color:var(--teal)}
  .tag.pcode{background:#123b31;color:#a9e6cf;font-family:"JetBrains Mono";letter-spacing:.02em}
  .report-tip{display:flex;align-items:center;gap:7px;font-family:"Archivo";font-size:11px;font-weight:600;letter-spacing:.02em;color:var(--navy);padding:1px 3px 4px}
  .hexmark{width:12px;height:12px;flex:none;background:var(--coral);clip-path:polygon(25% 5%,75% 5%,100% 50%,75% 95%,25% 95%,0% 50%)}
  .grid-hint.loading-dots::after{content:"";display:inline-block;width:6px;height:6px;margin-left:5px;border-radius:50%;background:var(--teal);animation:pulse 1s infinite;vertical-align:middle}

  .coordbox{position:relative}
  .coord-fields{display:flex;gap:6px}
  .coord-fields input{
    width:100%;font-family:"JetBrains Mono";font-size:12px;
    border:1px solid var(--line);border-radius:7px;padding:7px 8px;background:#fff;color:var(--ink)}
  .coord-fields input:focus{outline:2px solid var(--teal);border-color:var(--teal)}
  .coord-go{
    font-family:"Archivo";text-transform:uppercase;letter-spacing:.05em;font-size:11px;font-weight:700;
    background:var(--teal);color:#fff;border:0;border-radius:7px;padding:8px 10px;cursor:pointer;width:100%;margin-top:6px}
  .coord-go:hover{background:var(--teal-l)}

  /* chartplotter readout */
  .readout{
    position:absolute;left:12px;bottom:12px;z-index:500;
    background:rgba(9,32,42,.92);border:1px solid #1d4d5d;border-radius:10px;
    padding:9px 13px;box-shadow:var(--shadow);backdrop-filter:blur(3px)}
  .readout .rl{font-family:"Archivo";text-transform:uppercase;letter-spacing:.16em;font-size:8.5px;color:#5f95a4;margin-bottom:3px}
  .readout .rv{font-family:"JetBrains Mono";font-weight:500;font-size:13px;color:#7ff0d9;letter-spacing:.02em}
  .readout .rv2{font-family:"JetBrains Mono";font-size:10px;color:#89b6c2;margin-top:2px}

  .disclaimer{
    position:absolute;right:12px;bottom:12px;z-index:500;max-width:260px;
    background:rgba(251,247,236,.94);border:1px solid var(--line);border-radius:9px;
    padding:8px 11px;box-shadow:var(--shadow);font-size:10.5px;color:var(--muted);line-height:1.4}
  .disclaimer b{color:var(--coral-d);font-family:"Archivo";text-transform:uppercase;letter-spacing:.05em;font-size:9.5px}

  .banner{
    position:absolute;left:50%;top:12px;transform:translateX(-50%);z-index:520;
    background:var(--navy);color:#dff1f5;font-family:"Archivo";text-transform:uppercase;letter-spacing:.06em;
    font-size:11.5px;font-weight:600;padding:9px 16px;border-radius:999px;box-shadow:var(--shadow-lg);
    display:none;align-items:center;gap:9px}
  .banner.show{display:flex}
  .banner .pulse{width:8px;height:8px;border-radius:50%;background:var(--coral);animation:pulse 1.1s infinite}
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}

  .warnbar{
    position:absolute;left:12px;top:12px;z-index:490;display:none;
    background:#fbe3da;color:var(--coral-d);border:1px solid #f0b7a4;border-radius:9px;
    padding:8px 12px;font-size:11.5px;max-width:220px;line-height:1.35;box-shadow:var(--shadow)}
  .warnbar.show{display:block}

  /* mobile sidebar toggle */
  .drawer-toggle{display:none}

  /* ---------- Modal ---------- */
  .modal-bg{
    position:fixed;inset:0;background:rgba(6,20,26,.55);z-index:1000;
    display:none;align-items:center;justify-content:center;padding:18px;backdrop-filter:blur(2px)}
  .modal-bg.open{display:flex}
  .modal{
    background:var(--paper);border-radius:16px;box-shadow:var(--shadow-lg);
    width:min(560px,100%);max-height:92vh;display:flex;flex-direction:column;overflow:hidden}
  .modal-head{
    background:var(--navy);color:var(--paper);padding:15px 20px;display:flex;align-items:center;gap:12px}
  .modal-head .mh-ic{width:30px;height:30px;border-radius:8px;background:var(--coral);display:grid;place-items:center;flex:none}
  .modal-head .mh-ic.poly{background:var(--teal)}
  .modal-head h3{font-family:"Archivo";font-weight:700;font-size:16px;margin:0;letter-spacing:.02em}
  .modal-head .mh-sub{font-family:"JetBrains Mono";font-size:11px;color:#9dc4cf;margin-top:2px}
  .modal-head .x{margin-left:auto;background:none;border:0;color:#9dc4cf;font-size:24px;cursor:pointer;line-height:1;padding:2px 4px}
  .modal-head .x:hover{color:#fff}
  .modal-body{padding:18px 20px;overflow-y:auto}

  .coord-readout-form{
    background:#0a2a37;border-radius:10px;padding:11px 14px;margin-bottom:16px}
  .coord-readout-form .rl{font-family:"Archivo";text-transform:uppercase;letter-spacing:.14em;font-size:8.5px;color:#5f95a4;margin-bottom:4px}
  .coord-readout-form .rv{font-family:"JetBrains Mono";font-size:13.5px;color:#7ff0d9}
  .coord-readout-form .rv2{font-family:"JetBrains Mono";font-size:10.5px;color:#89b6c2;margin-top:3px}

  .field{margin-bottom:14px}
  .field > label{
    display:block;font-family:"Archivo";text-transform:uppercase;letter-spacing:.07em;
    font-size:10.5px;font-weight:600;color:var(--navy);margin-bottom:6px}
  .field .req{color:var(--coral)}
  .field input[type=text],.field input[type=number],.field input[type=datetime-local],
  .field select,.field textarea{
    width:100%;font-family:"Inter";font-size:14px;color:var(--ink);
    border:1px solid var(--line);border-radius:9px;padding:10px 11px;background:#fff}
  .field textarea{resize:vertical;min-height:64px;line-height:1.45}
  .field input:focus,.field select:focus,.field textarea:focus{outline:2px solid var(--teal);border-color:var(--teal)}
  .grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .hint{font-size:11px;color:var(--muted);margin-top:5px}

  .photo-drop{
    border:1.5px dashed var(--line);border-radius:11px;padding:16px;text-align:center;
    cursor:pointer;color:var(--muted);font-size:13px;background:#fff;transition:.12s}
  .photo-drop:hover{border-color:var(--teal);color:var(--teal);background:#fbfdfd}
  .photo-drop svg{margin-bottom:6px}
  .previews{display:flex;flex-wrap:wrap;gap:9px;margin-top:11px}
  .thumb{position:relative;width:74px;height:74px;border-radius:9px;overflow:hidden;border:1px solid var(--line)}
  .thumb img{width:100%;height:100%;object-fit:cover;display:block}
  .thumb .rm{position:absolute;top:3px;right:3px;width:20px;height:20px;border-radius:50%;
    background:rgba(6,20,26,.72);color:#fff;border:0;cursor:pointer;font-size:13px;line-height:1;display:grid;place-items:center}
  .thumb .rm:hover{background:var(--coral)}

  .modal-foot{padding:14px 20px;border-top:1px solid var(--line);display:flex;gap:10px;background:var(--paper)}
  .btn{font-family:"Archivo";text-transform:uppercase;letter-spacing:.06em;font-weight:700;font-size:13px;
    cursor:pointer;border-radius:10px;padding:12px 18px;border:1px solid transparent}
  .btn-primary{background:var(--coral);color:#fff}
  .btn-primary:hover{background:var(--coral-d)}
  .btn-primary:disabled{opacity:.5;cursor:not-allowed}
  .btn-ghost{background:transparent;border-color:var(--line);color:var(--navy)}
  .btn-ghost:hover{background:var(--buff)}
  .btn-danger{background:transparent;border-color:#e6b3a3;color:var(--coral-d)}
  .btn-danger:hover{background:#fbe3da}
  .grow{flex:1}

  /* detail view */
  .detail-block{margin-bottom:15px}
  .detail-block .dl{font-family:"Archivo";text-transform:uppercase;letter-spacing:.09em;font-size:9.5px;color:var(--muted);margin-bottom:3px}
  .detail-block .dv{font-size:15px;color:var(--ink)}
