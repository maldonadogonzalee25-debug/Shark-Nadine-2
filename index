  function toCSV(){
    const cols=['id','datetime','participant_id','geometry','hex_id','latitude','longitude','shark_species','target_species','outcome','fish_depredated','gear','depth_ft','reporter','vessel','photo_count','notes'];
    const q=v=>{ v=String(v==null?'':v); return /[",\n]/.test(v)?'"'+v.replace(/"/g,'""')+'"':v; };
    const lines=[cols.join(',')];
    for(const e of entries){
      lines.push([
        e.id, e.datetime, e.participantId||'', e.geomType, e.hexId||'', e.center[0].toFixed(6), e.center[1].toFixed(6),
