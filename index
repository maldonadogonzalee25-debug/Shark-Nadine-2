<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<script>
(function(){
  "use strict";

  /* ---------------- species reference lists ---------------- */
  const SHARKS = [
    "Great hammerhead","Scalloped hammerhead","Bull shark","Sandbar shark","Blacktip shark",
    "Spinner shark","Dusky shark","Silky shark","Tiger shark","Lemon shark","Nurse shark",
    "Caribbean reef shark","Blacknose shark","Atlantic sharpnose shark","Shortfin mako",
    "Oceanic whitetip","White shark","Unidentified shark"
  ];
  const TARGETS = [
    ["Pelagic", ["Yellowfin tuna","Blackfin tuna","Bigeye tuna","Little tunny / bonito","Mahi-mahi (dolphinfish)","Wahoo","King mackerel","Spanish mackerel","Cero mackerel","Sailfish","Blue marlin","White marlin"]],
    ["Reef & bottom", ["Red snapper","Vermilion snapper","Mutton snapper","Yellowtail snapper","Gray (mangrove) snapper","Red grouper","Gag grouper","Black grouper","Greater amberjack","Hogfish","Grunts"]],
    ["Coastal & inshore", ["Cobia","Tarpon","Snook","Red drum","Sheepshead","Spotted seatrout"]]
  ];
  const GEAR = ["Rod & reel — conventional","Rod & reel — spinning","Trolling","Vertical / bottom jigging","Bandit / electric reel","Handline","Longline","Spearfishing","Trap / pot","Other"];
  const OUTCOMES = ["Whole catch taken","Partial — bite marks / portion left","Gear or tackle damaged","Attempted — no loss","Unknown"];

  /* ============================================================
     RESEARCHER SETUP — to send every report straight to YOUR Google Sheet,
     paste your Apps Script Web-app URL between the quotes below (it ends in /exec).
     Once set here, anyone who opens this file submits to your Sheet automatically —
     no in-app setup needed. Leave blank to configure per-device in the app instead.
     ============================================================ */
  const DEFAULT_ENDPOINT  = "https://script.google.com/macros/s/AKfycbxmW69jY5MoT-5-jFW_zo3i0frtZlFUtW2qWaeXSXI7G-taN2JNBBaNxfLtwGYWgFZY/exec";   // e.g. "https://script.google.com/macros/s/AKfy.../exec"
  const DEFAULT_SHEET_URL = "https://docs.google.com/spreadsheets/d/1HE0_pOWgyFwtOt0FnTKr0ZDMRzPsTBqXu2eJymQWbNs/edit?usp=sharing";   // optional: your Google Sheet link (for "Open dashboard")

  /* ---------------- storage layer (Claude storage → localStorage → memory) ---------------- */
  const KEY = "sde:entry:";
  let ephemeral = false;
  const mem = {};
  const backend = (function(){
    try{ if(window.storage && typeof window.storage.list==='function') return 'ws'; }catch(e){}
    try{ if(typeof localStorage!=='undefined'){ localStorage.setItem('sde:t','1'); localStorage.removeItem('sde:t'); return 'ls'; } }catch(e){}
    ephemeral = true; return 'mem';
  })();
  const S = {
    async rawGet(k){
      if(backend==='ws'){ try{ return await window.storage.get(k); }catch(e){ return null; } }
      if(backend==='ls'){ const v=localStorage.getItem(k); return v==null?null:{value:v}; }
      return mem[k]!=null?{value:mem[k]}:null;
    },
    async rawSet(k,v){
      if(backend==='ws') return window.storage.set(k,v);
      if(backend==='ls'){ localStorage.setItem(k,v); return; }
      mem[k]=v;
    },
    async rawDel(k){
      if(backend==='ws'){ try{ return await window.storage.delete(k); }catch(e){} return; }
      if(backend==='ls'){ localStorage.removeItem(k); return; }
      delete mem[k];
    },
    async keys(prefix){
      if(backend==='ws'){ try{ const r=await window.storage.list(prefix); return (r&&r.keys)||[]; }catch(e){ return []; } }
      if(backend==='ls'){ const out=[]; for(let i=0;i<localStorage.length;i++){ const k=localStorage.key(i); if(k&&k.indexOf(prefix)===0) out.push(k); } return out; }
      return Object.keys(mem).filter(k=>k.indexOf(prefix)===0);
    },
    async set(id, obj){ return this.rawSet(KEY+id, JSON.stringify(obj)); },
    async del(id){ return this.rawDel(KEY+id); },
    async all(){
      const ks=await this.keys(KEY); const out=[];
      for(const k of ks){ const r=await this.rawGet(k); if(r&&r.value){ try{ out.push(JSON.parse(r.value)); }catch(e){} } }
      return out;
    },
    raw:{
      get(k){ return S.rawGet(k); },
      set(k,v){ return S.rawSet(k,v); },
      del(k){ return S.rawDel(k); }
    }
  };

  /* ---------------- state ---------------- */
  let entries = [];                 // in-memory copy
  const layerIndex = {};            // id -> leaflet layer
  let pending = null;               // { geometry, geomType, center }
  let editingId = null;             // id when editing existing
  let formPhotos = [];              // data URIs in the open form
  let savedFG;                      // FeatureGroup of saved layers
  let gridLayer = null;             // L.geoJSON reference hex grid
  let gridData = null;              // raw grid GeoJSON (accumulated)
  let gridIdx = 0;                  // running feature index for id fallback
  let gridTotal = 0;               // cells added so far
  let userMoved = false;           // user has panned/zoomed the map
  let participantId = '';          // current participant / survey code, stamped on new events
  let SUBMIT_ENDPOINT = DEFAULT_ENDPOINT;   // researcher's Apps Script web-app URL (built-in or set in-app)
  let SHEET_URL = DEFAULT_SHEET_URL;        // researcher's Google Sheet dashboard link
  let syncing = false;
  const GRIDKEY = 'sde:grid';
  const PARTKEY = 'sde:participant';
  const ENDPOINTKEY = 'sde:endpoint';
  const SHEETKEY = 'sde:sheeturl';

  /* ---------------- map ---------------- */
  // Bounds cover the hex layer's true extent (South Atlantic Bight EEZ, FL→NC).
  // Tightened to the actual grid once it loads so nothing is ever clipped.
  const NC_BOUNDS = L.latLngBounds([[26.6, -81.3], [36.6, -71.6]]);
  const map = L.map('map', {
    zoomControl:true, preferCanvas:true,
    maxBounds: NC_BOUNDS, maxBoundsViscosity: 1.0,
    minZoom: 5, maxZoom: 18
  }).setView([31.1, -76.7], 6);

  // NOAA cached chart tiles. This cache's level 0 == standard web-mercator zoom 2,
  // so tiles are requested with zoomOffset -2 (URL level = mapZoom - 2, x/y at mapZoom).
  const noaa = L.tileLayer(
    'https://gis.charttools.noaa.gov/arcgis/rest/services/MarineChart_Services/NOAACharts/MapServer/tile/{z}/{y}/{x}',
    { minNativeZoom:2, maxNativeZoom:18, zoomOffset:-2, maxZoom:18, bounds: NC_BOUNDS,
      attribution:'NOAA Office of Coast Survey — nautical charts, not for navigation' }
  );
  const oceanBase = L.tileLayer(
    'https://services.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Base/MapServer/tile/{z}/{y}/{x}',
    { maxZoom:18, maxNativeZoom:13, bounds: NC_BOUNDS, attribution:'Esri, GEBCO, NOAA' }
  );
  const oceanRef = L.tileLayer(
    'https://services.arcgisonline.com/ArcGIS/rest/services/Ocean/World_Ocean_Reference/MapServer/tile/{z}/{y}/{x}',
    { maxZoom:18, maxNativeZoom:13, bounds: NC_BOUNDS }
  );
  const esriOcean = L.layerGroup([oceanBase, oceanRef]);
  const osm = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
    { maxZoom:19, bounds: NC_BOUNDS, attribution:'© OpenStreetMap contributors' });
  const seamarks = L.tileLayer('https://tiles.openseamap.org/seamark/{z}/{x}/{y}.png',
    { maxZoom:18, bounds: NC_BOUNDS, attribution:'© OpenSeaMap' });

  noaa.addTo(map);
  L.control.layers(
    { "NOAA nautical charts": noaa, "Esri ocean basemap": esriOcean, "OpenStreetMap": osm },
    { "Sea marks (buoys, beacons)": seamarks },
    { position:'topright' }
  ).addTo(map);

  // Watchdog: if NOAA tiles never load, fall back to the ocean basemap so the map is never blank.
  let noaaOK=0, noaaErr=0;
  noaa.on('tileload', ()=>{ noaaOK++; });
  noaa.on('tileerror', ()=>{ noaaErr++; });
  setTimeout(()=>{
    if(noaaOK===0 && noaaErr>0 && map.hasLayer(noaa)){
      map.removeLayer(noaa); esriOcean.addTo(map);
      document.querySelector('.disclaimer').innerHTML='<b>Basemap.</b> NOAA chart service isn’t responding right now — showing the Esri ocean basemap. Re-select NOAA from the layer switcher to retry.';
      toast('NOAA charts unavailable — switched to the ocean basemap. Reports still work normally.');
    }
  }, 7000);

  savedFG = L.featureGroup().addTo(map);

  const eventIcon = L.divIcon({ className:'sde-pin', html:'<div class="pin-core"></div>', iconSize:[22,22], iconAnchor:[11,11] });

  // cursor readout
  map.on('mousemove', e=>{
    document.getElementById('roDDM').textContent = toDDM(e.latlng.lat, e.latlng.lng);
    document.getElementById('roDec').textContent = 'lat '+e.latlng.lat.toFixed(5)+', lon '+e.latlng.lng.toFixed(5);
  });
  map.on('dragstart', ()=>{ userMoved=true; });
  map.getContainer().addEventListener('wheel', ()=>{ userMoved=true; }, {passive:true});

  document.addEventListener('keydown', e=>{ if(e.key==='Escape'){ closeModal(); }});

  /* ---------------- hex grid ---------------- */
  const HEXID_FIELDS = ['GRID_ID','grid_id','GridID','HEX_ID','hex_id','HEXID','hexid','H3','h3','GEOID','geoid','CELL_ID','cell_id','Cell_ID','id','ID','OBJECTID','objectid','FID','fid'];
  // Reference tessellation grid — styled to match the ArcGIS layer (Tesellas_shark_NH):
  // light-cyan outline, no fill. interactive:false so taps fall through to the map for drawing.
  const gridStyle = { color:'#73DFFF', weight:1.1, opacity:.9, fill:false, interactive:false };
  const gridHover = { color:'#E4572E', weight:1.2, opacity:.9, fillColor:'#E4572E', fillOpacity:.12 };

  function hexIdOf(props, idx){
    if(props){ for(const f of HEXID_FIELDS){ if(props[f]!=null && props[f]!=='') return String(props[f]); } }
    return 'cell-'+(idx+1);
  }
  function featureList(gj){
    if(!gj) return [];
    if(gj.type==='FeatureCollection') return gj.features||[];
    if(gj.type==='Feature') return [gj];
    if(gj.type&&gj.coordinates) return [{type:'Feature',geometry:gj,properties:{}}];
    return [];
  }
  function looksProjected(gj){
    let bad=false, checked=0;
    function scan(c){
      if(bad||checked>60||!c) return;
      if(typeof c[0]==='number'){ if(Math.abs(c[0])>180||Math.abs(c[1])>90) bad=true; checked++; return; }
      for(const x of c){ scan(x); if(bad) return; }
    }
    for(const f of featureList(gj)){ if(f&&f.geometry) scan(f.geometry.coordinates); if(bad) break; }
    return bad;
  }

  const HEX_SERVICE = 'https://services2.arcgis.com/sJvSsHKKEOKRemAr/arcgis/rest/services/Maldo_Shark_Hex/FeatureServer/0/query';
  const GRIDCACHE = 'sde:gridcache';
  const GRID_CAP = 20000; // safety cap so a very large grid can't freeze the browser

  // Tighten the map to the grid's real footprint so the whole grid is reachable & framed.
  function fitToGrid(fit){
    try{
      const b = gridLayer && gridLayer.getBounds();
      if(b && b.isValid()){
        map.setMaxBounds(b.pad(0.25));
        if(fit && !userMoved && !entries.length){ map.fitBounds(b, {padding:[20,20]}); }
      }
    }catch(e){}
  }

  function raf(){ return new Promise(r=>requestAnimationFrame(()=>r())); }

  // Assign each cell an id once (no per-feature handler — one delegated handler covers all cells).
  function assignHexId(feature){
    feature.properties = feature.properties || {};
    feature.properties.__id = hexIdOf(feature.properties, gridIdx++);
  }
  // Single delegated click handler on the whole grid: opens the report form for the tapped cell.
  function onGridClick(e){
    const layer = e.propagatedFrom || e.sourceTarget || e.layer;
    if(!layer || !layer.feature) return;
    if(e.originalEvent){ L.DomEvent.stopPropagation(e.originalEvent); }
    const f = layer.feature;
    const id = (f.properties && f.properties.__id) || hexIdOf(f.properties, 0);
    const c = layer.getBounds().getCenter();
    pending = { geometry:f.geometry, geomType:'hexagon', center:[c.lat,c.lng], hexId:id };
    openForm();
  }

  function initGridLayer(){
    if(gridLayer){ map.removeLayer(gridLayer); gridLayer=null; }
    gridIdx=0; gridTotal=0; gridData={ type:'FeatureCollection', features:[] };
    // Display-only reference layer: no per-cell click (people draw areas on top instead).
    gridLayer = L.geoJSON(null, { style:gridStyle, interactive:false });
    const gs=document.getElementById('gridShow'); if(!gs || gs.checked) gridLayer.addTo(map);
  }

  function updateHexCount(n){
    const st=document.getElementById('gridStatus'); if(st) st.style.display='flex';
    const hc=document.getElementById('hexCount'); if(hc) hc.textContent=n.toLocaleString()+' cells';
  }
  function gridHintText(txt, loading){
    const h=document.getElementById('gridHint');
    h.style.display='block'; h.textContent=txt;
    h.classList.toggle('loading-dots', !!loading);
  }

  // Add features to the live grid in chunks so the UI never blocks.
  async function addGridFeatures(feats){
    for(let k=0;k<feats.length;k+=600){
      const chunk=feats.slice(k,k+600);
      gridLayer.addData({ type:'FeatureCollection', features:chunk });
      gridData.features.push(...chunk);
      gridTotal+=chunk.length;
      updateHexCount(gridTotal);
      await raf();
    }
  }

  // Render an already-in-hand grid (from the local cache) — no network.
  async function renderGridFeatures(feats, fit){
    initGridLayer();
    gridHintText('Drawing hex grid…', true);
    await addGridFeatures(feats);
    fitToGrid(fit);
    gridHintText(gridTotal.toLocaleString()+' reference cells · trace your area on top', false);
  }

  async function fetchHexPage(offset, page){
    const params=new URLSearchParams({
      where:'1=1', outFields:'GRID_ID', returnGeometry:'true',
      outSR:'4326', f:'geojson', geometryPrecision:'5',
      orderByFields:'OBJECTID', resultRecordCount:String(page), resultOffset:String(offset)
    });
    const res=await fetch(HEX_SERVICE+'?'+params.toString());
    if(!res.ok) throw new Error('HTTP '+res.status);
    const j=await res.json();
    if(j.error) throw new Error(j.error.message||'service error');
    return (j&&j.features)||[];
  }

  async function cacheGrid(){
    try{
      const str=JSON.stringify(gridData);
      if(str.length < 4.5*1024*1024){ await S.raw.set(GRIDCACHE, str); }
      else { try{ await S.raw.del(GRIDCACHE); }catch(e){} } // too big to cache; fetch fresh next time
    }catch(e){}
  }

  // Stream the ArcGIS hex layer page-by-page in the background, then cache it locally.
  async function streamServiceGrid(persist, fit){
    const btn=document.getElementById('toolGridService');
    if(btn) btn.classList.add('loading');
    initGridLayer();
    gridHintText('Loading shark hex grid…', true);
    const page=2000; let offset=0, guard=0, fitted=false, capped=false;
    try{
      while(guard++ < 400){
        const feats=await fetchHexPage(offset, page);
        if(!feats.length) break;
        gridHintText('Loading shark hex grid… '+(gridTotal+feats.length).toLocaleString()+' cells', true);
        await addGridFeatures(feats);
        if(!fitted && fit && !userMoved && !entries.length){
          try{ map.fitBounds(gridLayer.getBounds(),{padding:[20,20]}); }catch(e){}
          fitted=true;
        }
        if(gridTotal >= GRID_CAP){ capped=true; break; }
        if(feats.length < page) break;
        offset += page;
      }
      if(!capped) fitToGrid(fit);
      gridHintText(capped
        ? (gridTotal.toLocaleString()+'+ cells (large grid — capped for speed)')
        : (gridTotal.toLocaleString()+' cells · tap one to report'), false);
      if(persist){ try{ await S.raw.set(GRIDKEY, JSON.stringify({kind:'service'})); }catch(e){} }
      if(!capped) cacheGrid(); // save for instant load next time (skip if capped/huge)
    }catch(e){
      gridHintText('Couldn’t reach the hex service — check your connection or load a file.', false);
      toast('Hex grid didn’t finish loading ('+(e.message||'network')+')');
    }finally{ if(btn) btn.classList.remove('loading'); }
  }

  // The reference grid ships as a GeoJSON file committed next to index.html in the repo.
  // Export Tesellas_shark_NH from ArcGIS Pro to GeoJSON in WGS84 (EPSG:4326) and save it
  // under this name. (A local .gdb / .lyrx can't be read by a browser.)
  const GRID_FILE_URL = 'Tesellas_shark_NH.geojson';
  async function loadDefaultGrid(){
    try{
      const res = await fetch(GRID_FILE_URL, { cache:'force-cache' });
      if(!res.ok){ gridHintText('Reference grid file not found — you can still trace areas.', false); return; }
      const text = await res.text();
      await loadGridFromText(text, false);
    }catch(e){
      // offline or file missing — drawing still works without the reference grid
      gridHintText('Reference grid not loaded — you can still trace areas.', false);
    }
  }

  async function loadGridFromText(text, persist){
    let gj;
    try{ gj=JSON.parse(text); }catch(e){ toast('That file isn’t valid GeoJSON'); return; }
    const feats = featureList(gj);
    if(!feats.length){ toast('No polygons found in that GeoJSON'); return; }
    if(looksProjected(gj)){ toast('Grid looks projected — re-export from ArcGIS Pro as GeoJSON in WGS84 (EPSG:4326).'); return; }
    const tbtn=document.getElementById('toolGridService'); if(tbtn) tbtn.classList.add('loading');
    try{
      await renderGridFeatures(feats, true);
      if(persist){
        try{
          const payload=JSON.stringify({kind:'file', text});
          if(payload.length < 4.4*1024*1024){ await S.raw.set(GRIDKEY, payload); try{ await S.raw.del(GRIDCACHE); }catch(e){} }
          else { toast('Grid loaded (too large to save between sessions — reload the file next time).'); }
        }catch(e){}
      }
    } finally { if(tbtn) tbtn.classList.remove('loading'); }
  }

  /* ---------------- click map → nearest hex_id → report ---------------- */
  let hexLookupBusy=false;
  function ringCentroid(geom){
    if(!geom) return null;
    let c=null;
    if(geom.type==='Polygon') c=geom.coordinates[0];
    else if(geom.type==='MultiPolygon') c=geom.coordinates[0] && geom.coordinates[0][0];
    if(!c||!c.length) return null;
    let x=0,y=0; for(const p of c){ x+=p[0]; y+=p[1]; }
    return [y/c.length, x/c.length]; // [lat,lng]
  }
  // Ask the FeatureServer which hex contains the point; if none, the nearest one.
  async function hexAt(lat, lng){
    const geom=JSON.stringify({ x:lng, y:lat, spatialReference:{ wkid:4326 } });
    // 1) containing hex (point-in-polygon)
    try{
      const p=new URLSearchParams({ geometry:geom, geometryType:'esriGeometryPoint', inSR:'4326',
        spatialRel:'esriSpatialRelIntersects', outFields:'GRID_ID', returnGeometry:'false', f:'json' });
      const r=await fetch(HEX_SERVICE+'?'+p.toString()); const j=await r.json();
      if(j&&j.features&&j.features.length){ const a=j.features[0].attributes||{}; if(a.GRID_ID!=null) return { id:String(a.GRID_ID), inside:true }; }
    }catch(e){}
    // 2) nearest hex within ~30 km
    try{
      const p=new URLSearchParams({ geometry:geom, geometryType:'esriGeometryPoint', inSR:'4326',
        distance:'30000', units:'esriSRUnit_Meter', spatialRel:'esriSpatialRelIntersects',
        outFields:'GRID_ID', returnGeometry:'true', outSR:'4326', geometryPrecision:'6', f:'geojson', resultRecordCount:'120' });
      const r=await fetch(HEX_SERVICE+'?'+p.toString()); const j=await r.json();
      const feats=(j&&j.features)||[]; let best=null, bd=Infinity;
      for(const f of feats){ const cen=ringCentroid(f.geometry); if(!cen) continue; const d=(cen[0]-lat)**2+(cen[1]-lng)**2; if(d<bd){ bd=d; best=f; } }
      if(best && best.properties && best.properties.GRID_ID!=null) return { id:String(best.properties.GRID_ID), inside:false };
    }catch(e){}
    return null;
  }
  /* ---------------- draw the depredation area(s) (tap corners → one or more polygons) ---------------- */
  // People trace the general area by tapping corner points. A report can hold several
  // separate areas. The raw polygon(s) are stored on the event; the hex cells inside them
  // are worked out later on the data side.
  const drawPts = [];                 // L.latLng vertices of the area being traced now
  let drawShape = null;               // live preview of the in-progress area
  const drawMarkers = [];             // vertex handles for the in-progress area
  const committedAreas = [];          // finished areas: { latlngs:[L.latLng...], ring:[[lng,lat]...], layer }

  const drawCtrls = document.getElementById('drawCtrls');
  const drawCountEl = document.getElementById('drawCount');
  const btnUndo = document.getElementById('drawUndo');
  const btnClear = document.getElementById('drawClear');
  const btnFinish = document.getElementById('drawFinish');   // "Add area"
  const btnDone = document.getElementById('drawDone');        // "Done → form"

  function vtxIcon(first){ return L.divIcon({ className:'', html:'<div class="draw-vertex'+(first?' first':'')+'"></div>', iconSize:[12,12], iconAnchor:[6,6] }); }

  function redrawDraw(){
    if(drawShape){ map.removeLayer(drawShape); drawShape=null; }
    if(drawPts.length>=2){
      drawShape = (drawPts.length>=3)
        ? L.polygon(drawPts, { color:'#E4572E', weight:2.5, dashArray:'6 5', fillColor:'#E4572E', fillOpacity:.12 })
        : L.polyline(drawPts, { color:'#E4572E', weight:2.5, dashArray:'6 5' });
      drawShape.addTo(map);
    }
    const n = drawPts.length, a = committedAreas.length;
    const parts = [];
    parts.push(a + (a===1?' area':' areas'));
    if(n>0) parts.push(n + (n===1?' pt':' pts'));
    drawCountEl.textContent = parts.join('  ·  ');
    drawCtrls.classList.toggle('on', n>0 || a>0);
    btnUndo.disabled  = (n===0 && a===0);
    btnClear.disabled = (n===0 && a===0);
    btnFinish.disabled = n<3;                 // need a valid ring to add
    btnDone.disabled   = (a===0 && n<3);      // need at least one area (trailing ring auto-added)
  }

  function addDrawPoint(latlng){
    drawPts.push(latlng);
    const m = L.marker(latlng, { icon:vtxIcon(drawPts.length===1), keyboard:false, interactive:false }).addTo(map);
    drawMarkers.push(m);
    redrawDraw();
  }
  function clearCurrent(){
    drawPts.length = 0;
    drawMarkers.forEach(m=>map.removeLayer(m)); drawMarkers.length = 0;
    if(drawShape){ map.removeLayer(drawShape); drawShape=null; }
  }
  function undoDrawPoint(){
    if(drawPts.length){                         // step back one point in the current area
      drawPts.pop();
      const m = drawMarkers.pop(); if(m) map.removeLayer(m);
      redrawDraw();
    } else if(committedAreas.length){            // nothing in progress → remove the last saved area
      const area = committedAreas.pop();
      if(area.layer) map.removeLayer(area.layer);
      redrawDraw();
    }
  }
  function clearDraw(){                           // wipe everything for this report
    clearCurrent();
    committedAreas.forEach(area=>{ if(area.layer) map.removeLayer(area.layer); });
    committedAreas.length = 0;
    redrawDraw();
  }
  function centroidOf(pts){
    let x=0,y=0; for(const p of pts){ x+=p.lng; y+=p.lat; }
    return [y/pts.length, x/pts.length]; // [lat,lng]
  }
  // Local calendar date (YYYY-MM-DD) for auto-captured report dates.
  function todayLocal(){ const n=new Date(); n.setMinutes(n.getMinutes()-n.getTimezoneOffset()); return n.toISOString().slice(0,10); }
  // Commit the in-progress area to the report's set and keep drawing.
  function addArea(){
    if(drawPts.length<3){ toast('Add at least 3 points to close the area'); return false; }
    const ring = drawPts.map(p=>[p.lng, p.lat]);
    ring.push([drawPts[0].lng, drawPts[0].lat]); // close the ring
    const layer = L.polygon(drawPts, { color:'#118AB2', weight:2, fillColor:'#118AB2', fillOpacity:.14 }).addTo(map);
    committedAreas.push({ latlngs:[...drawPts], ring, layer });
    clearCurrent();
    redrawDraw();
    return true;
  }
  // Finish the report: auto-add any trailing ring, then build the geometry and open the form.
  function finishDraw(){
    if(drawPts.length>=3){ addArea(); }
    else if(drawPts.length>0){ toast('That area needs at least 3 points — finish or clear it first'); return; }
    if(!committedAreas.length){ toast('Trace at least one area'); return; }

    const rings = committedAreas.map(a=>a.ring);
    const geometry = (rings.length===1)
      ? { type:'Polygon', coordinates:[rings[0]] }
      : { type:'MultiPolygon', coordinates: rings.map(r=>[r]) };
    const allPts = committedAreas.reduce((acc,a)=>acc.concat(a.latlngs), []);
    pending = {
      geometry,
      geomType:'polygon',
      center: centroidOf(allPts),
      areaCount: committedAreas.length,
      hexId: undefined   // hex cells inside the polygon(s) are assigned later, on the data side
    };
    clearDraw();
    openForm();
  }

  function onMapClick(e){
    if(document.getElementById('modalBg').classList.contains('open')) return; // ignore taps behind a modal
    addDrawPoint(e.latlng);
  }
  map.on('click', onMapClick);
  btnUndo.onclick = undoDrawPoint;
  btnClear.onclick = clearDraw;
  btnFinish.onclick = addArea;
  btnDone.onclick = finishDraw;

  /* ---------------- coordinate formatting ---------------- */
  function toDDM(lat, lon){
    function f(v,pos,neg){ const h=v>=0?pos:neg; v=Math.abs(v); const d=Math.floor(v); const m=(v-d)*60; return d+'° '+m.toFixed(3)+"' "+h; }
    return f(lat,'N','S')+'   '+f(lon,'E','W');
  }

  /* ---------------- rendering saved entries ---------------- */
  function savedStyle(entry){
    return entry.geomType==='hexagon'
      ? { color:'#E4572E', weight:2, fillColor:'#E4572E', fillOpacity:.30 }
      : { color:'#E4572E', weight:2.5, fillColor:'#E4572E', fillOpacity:.18 };
  }

  function addLayer(entry){
    const layer = L.geoJSON(entry.geometry, {
      pointToLayer:(f,latlng)=>L.marker(latlng,{icon:eventIcon}),
      style: ()=>savedStyle(entry)
    });
    layer.bindPopup(popupHTML(entry), { minWidth:190 });
    layer.on('popupopen', ()=>{
      const btn=document.querySelector('.leaflet-popup .pbtn');
      if(btn) btn.onclick=()=>{ map.closePopup(); openDetail(entry.id); };
    });
    layer.addTo(savedFG);
    layerIndex[entry.id]=layer;
  }
  function popupHTML(entry){
    return '<div class="pop"><div class="pd">'+fmtDate(entry.datetime)+'</div>'+
      '<div class="ps">'+speciesLine(entry,' <span class="arrow">✕</span> ')+'</div>'+
      '<button class="pbtn">View details</button></div>';
  }
  function refreshLayer(entry){
    if(layerIndex[entry.id]){ savedFG.removeLayer(layerIndex[entry.id]); delete layerIndex[entry.id]; }
    addLayer(entry);
  }

