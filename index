    "        f.setSharing(DriveApp.Access.ANYONE_WITH_LINK,DriveApp.Permission.VIEW);",
    "        links.push(f.getUrl());",
    "      }catch(err){ links.push('ERROR'); } } }",
    "    sh.appendRow([new Date(),id,d.participant_id||'',d.datetime||'',d.geom_type||'',d.hex_id||'',",
    "      d.latitude||'',d.longitude||'',d.shark_species||'',d.target_species||'',d.outcome||'',",
    "      d.fish_depredated||'',d.gear||'',d.depth_ft||'',d.reporter||'',d.vessel||'',d.notes||'',",
    "      links.join('\\n'),JSON.stringify(d.geometry||null)]);",
    "    return json({ok:true,id:id});",
    "  }catch(err){ return json({ok:false,error:String(err)}); }",
    "  finally{ lock.releaseLock(); }",
    "}",
    "function getFolder_(n){ var it=DriveApp.getFoldersByName(n); return it.hasNext()?it.next():DriveApp.createFolder(n); }",
    "function json(o){ return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }"
  ].join("\n");

  function openSyncSettings(){
    const modal=document.getElementById('modal');
    modal.innerHTML=
    '<div class="modal-head">'+
      '<div class="mh-ic" style="background:#1f6b53"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2"><path d="M7 18a5 5 0 01-1-9.9A6 6 0 0118 9a4 4 0 011 7.9"/></svg></div>'+
      '<div><h3>Data destination</h3><div class="mh-sub">Send reports to your Google Sheet</div></div>'+
      '<button class="x" id="sClose" aria-label="Close">×</button>'+
    '</div>'+
    '<div class="modal-body">'+
      '<div class="pcode-note">Set this up once. Reports still save on each device and send automatically when online — you collect them all in one Google Sheet.</div>'+
      '<ol class="setup-steps">'+
        '<li>Open your Google Sheet, then <code>Extensions ▸ Apps Script</code>. <b>(Do this from inside the Sheet</b> — not script.google.com — so it links to your Sheet.)</li>'+
        '<li>Delete anything there, paste the script below, and click <b>Save</b> 💾.</li>'+
        '<li><code>Deploy ▸ New deployment</code>. Click the ⚙️ and choose <b>Web app</b>. Set <b>Execute as: Me</b> and <b>Who has access: Anyone</b>, then <b>Deploy</b>.</li>'+
        '<li>Click <b>Authorize access</b> → pick your account → <b>Advanced ▸ Go to (project) (unsafe)</b> → <b>Allow</b>. (This is normal for your own script.)</li>'+
        '<li>Copy the <b>Web app URL</b> (it ends in <code>/exec</code>), paste it below, and press <b>Save &amp; test</b>.</li>'+
      '</ol>'+
      '<div class="code-box"><button class="code-copy" id="sCopy">Copy</button>'+
        '<textarea id="sCode" readonly spellcheck="false">'+esc(APPS_SCRIPT)+'</textarea></div>'+
      '<div class="field" style="margin-top:14px"><label>Web app URL <span class="req">*</span></label>'+
        '<input type="text" id="sEndpoint" value="'+esc(SUBMIT_ENDPOINT)+'" placeholder="https://script.google.com/macros/s/…/exec" autocomplete="off"></div>'+
      '<div class="field"><label>Google Sheet link <span style="color:var(--muted);text-transform:none;letter-spacing:0;font-weight:400">(optional — for the “Open dashboard” button)</span></label>'+
        '<input type="text" id="sSheet" value="'+esc(SHEET_URL)+'" placeholder="https://docs.google.com/spreadsheets/…" autocomplete="off"></div>'+
      '<div class="sync-status-line" id="sStatus"></div>'+
    '</div>'+
    '<div class="modal-foot">'+
      (SUBMIT_ENDPOINT?'<button class="btn btn-danger" id="sDisconnect">Disconnect</button>':'')+
      '<div class="grow"></div>'+
      '<button class="btn btn-ghost" id="sTest">Save &amp; test</button>'+
      '<button class="btn btn-primary" id="sSave">Save</button>'+
    '</div>';
    openModal();
    document.getElementById('sClose').onclick=closeModal;
    document.getElementById('sCopy').onclick=()=>{
      const t=document.getElementById('sCode'); t.select();
      try{ document.execCommand('copy'); }catch(e){}
      if(navigator.clipboard){ navigator.clipboard.writeText(APPS_SCRIPT).catch(()=>{}); }
      document.getElementById('sCopy').textContent='Copied';
      setTimeout(()=>{ const c=document.getElementById('sCopy'); if(c) c.textContent='Copy'; },1500);
    };
    const persist=async()=>{
      SUBMIT_ENDPOINT=document.getElementById('sEndpoint').value.trim();
      SHEET_URL=document.getElementById('sSheet').value.trim();
      try{ await S.raw.set(ENDPOINTKEY, SUBMIT_ENDPOINT); await S.raw.set(SHEETKEY, SHEET_URL); }catch(e){}
      updateSyncUI();
    };
    if(document.getElementById('sDisconnect')) document.getElementById('sDisconnect').onclick=async()=>{
      document.getElementById('sEndpoint').value=''; await persist(); closeModal(); toast('Disconnected — now in local-only mode');
    };
    document.getElementById('sSave').onclick=async()=>{ await persist(); closeModal(); toast(SUBMIT_ENDPOINT?'Destination saved':'Saved'); if(SUBMIT_ENDPOINT) syncAll(true); };
    document.getElementById('sTest').onclick=async()=>{
      await persist();
      const st=document.getElementById('sStatus');
      if(!SUBMIT_ENDPOINT){ st.textContent='Enter the Web app URL first.'; return; }
      if(!/^https:\/\/script\.google\.com\/macros\/s\/.+\/exec/.test(SUBMIT_ENDPOINT)){
        st.innerHTML='⚠️ That doesn’t look like a Web app URL. It should start with <b>https://script.google.com/macros/s/…</b> and end in <b>/exec</b> (not /dev).';
        return;
      }
      st.textContent='Testing connection…';
      // 1) health check (GET). Reaches doGet, confirms the Sheet is wired up.
      let health=null, reached=false;
      try{ const r=await fetch(SUBMIT_ENDPOINT, {method:'GET'}); reached=true; health=await r.json(); }
      catch(e){ reached=false; }
      if(!reached){
        st.innerHTML='❌ Couldn’t reach the script. Almost always the deployment’s <b>“Who has access”</b> is not set to <b>Anyone</b>. In Apps Script: <b>Deploy ▸ Manage deployments ▸ ✏️ Edit ▸ Who has access: Anyone ▸ Deploy</b>. Also make sure you copied the <b>/exec</b> URL.';
        return;
      }
      if(health && health.ok===false){
        st.innerHTML='⚠️ The script ran but can’t find your Sheet ('+esc(health.error||'')+'). Either create the script from inside the Sheet (<b>Extensions ▸ Apps Script</b>), or set <b>SHEET_ID</b> at the top of the script to your Sheet’s ID.';
        return;
      }
      // 2) connection good — flush any pending reports
      st.textContent='Connected ✓  Sending reports…';
      await syncAll(true);
      const p=pendingCount();
      st.innerHTML = (p===0)
        ? '✅ Connected to your Sheet'+(health&&health.sheet?(' (<b>'+esc(health.sheet)+'</b>)'):'')+'. '+(entries.length?'All reports are uploaded.':'Ready — reports will send automatically.')
        : '⚠️ Connected, but '+p+' report(s) didn’t post. Re-deploy after any script edit: <b>Deploy ▸ Manage deployments ▸ Edit ▸ Version: New version ▸ Deploy</b>.';
    };
  }

  /* ---------------- welcome / how-to ---------------- */
  const WELCOMEKEY='sde:welcomed';
  function openWelcome(){
    const modal=document.getElementById('modal');
    modal.innerHTML=
    '<div class="modal-head">'+
      '<div class="mh-ic"><svg width="17" height="17" viewBox="0 0 32 32" fill="none"><path d="M4 20c3.2-.3 5-2.1 7.4-5.2C15.2 12.4 17.6 9 22 9c2.2 0 3.4 1.2 4 2.6-2 .1-3 .9-3 2.1 0 .9.7 1.6 1.8 1.8-1 1.9-3 3.4-6 3.9l1.6 2.2-3.3-.9-2.1 2-.5-2.7C10.9 22.3 8 21.6 6 20Z" fill="#fff"/></svg></div>'+
      '<div><h3>Depredation Log</h3><div class="mh-sub">Shark depredation event reporter</div></div>'+
      '<button class="x" id="wClose" aria-label="Close">×</button>'+
    '</div>'+
    '<div class="modal-body">'+
      '<p class="wlead">Report where sharks <b>took or damaged your catch</b>. You trace the general <b>area</b> on the nautical chart and tag it with your survey code, so researchers can match it to the paper survey and map where depredation happens most.</p>'+
      '<div class="wsteps">'+
        '<div class="wstep"><div class="wn">1</div><div class="wt"><b>Set your code</b> below — type the one we gave you, or <b>Generate</b> one and write it on the paper survey.</div></div>'+
        '<div class="wstep"><div class="wn">2</div><div class="wt"><b>Trace the area.</b> Tap the chart to drop each corner of the general area (3+ points), then press <b>Add area</b>. Trace as many separate areas as you need, then press <b>Done</b>.</div></div>'+
        '<div class="wstep"><div class="wn">3</div><div class="wt"><b>Confirm the details.</b> Check the participant code, add any notes, and log the event. The date is recorded automatically.</div></div>'+
        '<div class="wstep"><div class="wn">4</div><div class="wt">'+
          (SUBMIT_ENDPOINT
            ? '<b>That’s it — it sends itself.</b> Reports upload to the research team automatically when you’re online. No signal? They wait and send later.'
            : '<b>Export when done.</b> Use <b>Export</b> (top right) to download your reports as CSV or GeoJSON.')+
        '</div></div>'+
      '</div>'+
      '<div class="field" style="margin-top:2px"><label>Your participant / survey code</label>'+
        '<div class="pcode-row">'+
          '<input type="text" id="wPart" value="'+esc(participantId)+'" placeholder="Type the code we provided" autocomplete="off">'+
          '<button type="button" class="pcode-gen" id="wGen">Generate</button>'+
        '</div>'+
        '<div class="hint">Every report is stamped with this code. You can change it later from the person icon up top.</div></div>'+
      '<div class="wfoot"><b>Note:</b> '+
        (SUBMIT_ENDPOINT
          ? 'Reports save on this device first, then sync to the research team — nothing is lost if you go offline. '
          : 'Reports are saved privately on this device — export to share them. ')+
        'Charts are for reference only, <b>not for navigation</b>.</div>'+
    '</div>'+
    '<div class="modal-foot">'+
      '<div class="grow"></div>'+
      '<button class="btn btn-primary" id="wStart">Get started</button>'+
    '</div>';
    openModal();
    const done=async()=>{
      const el=document.getElementById('wPart');
      const v=(el?el.value:'').trim();
      if(v) await setParticipant(v);   // set typed/generated code; empty leaves any existing code untouched
      closeModal();
      try{ await S.raw.set(WELCOMEKEY,'1'); }catch(e){}
    };
    document.getElementById('wGen').onclick=()=>{ document.getElementById('wPart').value=genCode(); };
    document.getElementById('wClose').onclick=done;
    document.getElementById('wStart').onclick=done;
  }
  document.getElementById('helpBtn').onclick=openWelcome;
  document.getElementById('syncPill').onclick=()=>{ if(SUBMIT_ENDPOINT) syncAll(false); else openSyncSettings(); };
  window.addEventListener('online', ()=>{ if(SUBMIT_ENDPOINT) syncAll(true); });

  /* ---------------- drawer (mobile) ---------------- */
  document.getElementById('drawerToggle').onclick=()=>{
    document.getElementById('sidebar').classList.toggle('open');
  };

  /* ---------------- init ---------------- */
  async function init(){
    if(ephemeral){
      const w=document.getElementById('storeWarn');
      w.textContent='Persistent storage is unavailable here — events will stay only until you reload. Use Export → Full backup to keep them.';
      w.classList.add('show');
      setTimeout(()=>w.classList.remove('show'), 9000);
    }

    // load the current participant / survey code
    try{ const p=await S.raw.get(PARTKEY); if(p&&p.value){ participantId=p.value; } }catch(e){}
    updateParticipantUI();

    // load the data destination (researcher's Sheet endpoint)
    try{ const ep=await S.raw.get(ENDPOINTKEY); if(ep&&ep.value){ SUBMIT_ENDPOINT=ep.value; } }catch(e){}
    try{ const su=await S.raw.get(SHEETKEY); if(su&&su.value){ SHEET_URL=su.value; } }catch(e){}

    // first-time welcome / how-to
    try{ const seen=await S.raw.get(WELCOMEKEY); if(!(seen&&seen.value)){ openWelcome(); } }catch(e){ openWelcome(); }

    // 1) load saved events first so the map is usable immediately
    try{ entries = await S.all(); }catch(e){ entries=[]; }
    entries.forEach(addLayer);
    renderLog();
    updateSyncUI();
    if(entries.length){
      try{ map.fitBounds(savedFG.getBounds(), {maxZoom:8, padding:[50,50]}); }catch(e){}
    }
    setTimeout(()=>map.invalidateSize(),200);
    if(SUBMIT_ENDPOINT) syncAll(true); // flush any reports queued offline

    // Show the reference tessellation grid so people can trace areas on top of it.
    // (Grid is display-only — the hex cells inside each drawn area are worked out on the data side.)
    loadDefaultGrid();
  }

  async function restoreGrid(){
    try{
      const g=await S.raw.get(GRIDKEY);
      if(g&&g.value){
        let meta=null; try{ meta=JSON.parse(g.value); }catch(e){}
        if(meta&&meta.kind==='service'){
          // instant load from local cache, if present; otherwise fetch + cache
          const cached=await S.raw.get(GRIDCACHE);
          if(cached&&cached.value){
            try{ await renderGridFeatures(featureList(JSON.parse(cached.value)), true); return; }catch(e){}
          }
          streamServiceGrid(false, true);
        }
        else if(meta&&meta.kind==='file'&&meta.text){ loadGridFromText(meta.text, false); }
        else { loadGridFromText(g.value, false); } // legacy: raw geojson text
      } else {
        // first run: pull in the Maldonado shark hex grid automatically, then cache it
        streamServiceGrid(true, true);
      }
    }catch(e){ streamServiceGrid(true, true); }
  }

  window.addEventListener('resize', ()=>map.invalidateSize());
  init();
})();
</script>
