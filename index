  function toPayload(e){
    return {
      id:e.id, participant_id:e.participantId||'', datetime:e.datetime||'', created_at:e.createdAt||'',
      geom_type:e.geomType||'', hex_id:e.hexId||'',
      latitude:e.center?e.center[0]:'', longitude:e.center?e.center[1]:'',
      shark_species:displayShark(e), target_species:displayTarget(e),
      outcome:e.outcome||'', fish_depredated:e.numLost||'', gear:e.gear||'', depth_ft:e.depth||'',
      reporter:e.reporter||'', vessel:e.vessel||'', notes:e.notes||'',
