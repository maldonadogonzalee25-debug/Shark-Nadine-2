  async function syncEntry(e){
    if(!SUBMIT_ENDPOINT) return false;
    // If the hex lookup didn't run (e.g. logged offline), fill it in now that we're online.
    if(!e.hexId && e.center){ try{ const r=await hexAt(e.center[0], e.center[1]); if(r){ e.hexId=r.id; try{ await S.set(e.id,e); }catch(x){} } }catch(x){} }
    // plain-text body keeps this a "simple" CORS request (no preflight)
    const res=await fetch(SUBMIT_ENDPOINT,{ method:'POST', body:JSON.stringify(toPayload(e)) });
    let ok=false; try{ const j=await res.json(); ok=!!(j&&j.ok); }catch(err){ ok=res.ok; }
    if(ok){ e.synced=true; e.syncedAt=new Date().toISOString(); try{ await S.set(e.id,e); }catch(x){} }
    return ok;
  }
  async function syncAll(silent){
    if(!SUBMIT_ENDPOINT){ updateSyncUI(); if(!silent) toast('Connect your Google Sheet first (Export ▸ Data destination)'); return 0; }
    if(syncing) return 0;
    if(!navigator.onLine){ if(!silent) toast('You’re offline — reports will send automatically when back online'); updateSyncUI(); return 0; }
    const pend=entries.filter(e=>!e.synced);
    if(!pend.length){ updateSyncUI(); if(!silent) toast('Everything is already synced'); return 0; }
    syncing=true; updateSyncUI();
    let done=0, failed=0;
    for(const e of pend){ try{ if(await syncEntry(e)) done++; else failed++; }catch(err){ failed++; } }
    syncing=false; renderLog(); updateSyncUI();
    if(!silent){
      if(failed && !done) toast('Couldn’t reach your dashboard — check the URL and your connection');
      else if(failed) toast('Sent '+done+' — '+failed+' still pending, will retry');
      else toast('Sent '+done+' report'+(done===1?'':'s')+' to your dashboard');
    }
    return done;
  }

